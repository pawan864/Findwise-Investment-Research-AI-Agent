# --- LLM provider ---------------------------------------------------------
# "anthropic", "openai", or "google" (Gemini)
LLM_PROVIDER=google

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when LLM_PROVIDER=google) — free tier available
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# --- Optional research tools -----------------------------------------------
# Without these, the agent still runs — it just relies more on the LLM's own
# knowledge instead of live web/financial data. See README "Key decisions".

# Tavily (web/news search) — free tier: https://tavily.com
TAVILY_API_KEY=

# Alpha Vantage (fundamentals + quote) — free tier: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Database --------------------------------------------------------------
# MongoDB connection URI (local instance or MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/findwise
